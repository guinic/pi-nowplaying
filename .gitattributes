# This repo deploys to Linux (Raspberry Pi). Force LF on all text so shell
# scripts, systemd units and the CI YAML never get CRLF (a CRLF in a shebang
# breaks the interpreter on the Pi).
* text=auto eol=lf

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.md        text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
